# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/assistant_ai?schema=public

# Auth mode: local (demo JWT) | firebase (Ednov Copilot)
# Production MUST use AUTH_MODE=firebase (the API refuses to boot otherwise).
AUTH_MODE=local
# APPLICATION_DATA_SOURCE=ednov|prisma  (defaults from AUTH_MODE)

# Auth (required for AUTH_MODE=local — use a long random string in production)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h

# Firebase Admin (required when AUTH_MODE=firebase — same project as Ednov)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Ednov REST API (used by adapters; bearer = caller's Firebase token)
EDNOV_API_BASE_URL=http://localhost:3000/api/v1
# EDNOV_API_TIMEOUT_MS=15000
# EDNOV_API_RETRIES=2

# LLM
GEMINI_API_KEY=your-gemini-api-key
# Primary model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash
# Comma-separated fallbacks when primary hits quota/overload
GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-flash-latest

# CORS (comma-separated frontend origins — include Ednov web when embedding)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Behind reverse proxy / load balancer
# TRUST_PROXY=1

# Rate limiting
# THROTTLE_LIMIT=120
# THROTTLE_TTL_MS=60000
# SLOW_REQUEST_MS=2000

# Optional
# ENABLE_SWAGGER=true
# ENABLE_PUBLIC_REGISTER=false
# RAG_SIMILARITY_THRESHOLD=0.25
# Official functional documentation RAG (shared KB)
# DOCUMENTATION_SIMILARITY_THRESHOLD=0.42
