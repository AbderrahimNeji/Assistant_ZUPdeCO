{
  "name": "ednov-web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm ci && bash scripts/setup-cursor-rules.sh",
    "cursor-rules": "bash scripts/setup-cursor-rules.sh",
    "cursor-rules:update": "cp .cursor/rules.example/*.mdc .cursor/rules/",
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,scss}\"",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -f docker/Dockerfile -t ednov-web .",
    "docker:run": "docker run -p 8080:80 ednov-web",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "docker:dev:build": "docker-compose -f docker-compose.dev.yml up --build",
    "docker:prod": "docker-compose up --build",
    "docker:down": "docker-compose down",
    "firebase:deploy": "firebase deploy --only hosting",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "@tanstack/react-query": "^5.62.0",
    "@types/dompurify": "^3.0.5",
    "apexcharts": "^5.10.1",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.3",
    "express": "^4.21.2",
    "firebase": "^11.1.0",
    "lucide-react": "^0.576.0",
    "react": "^19.0.0",
    "react-apexcharts": "^2.1.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "react-remove-scroll": "^2.7.2",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.6",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "firebase-tools": "^15.9.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsc-files": "^1.1.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
