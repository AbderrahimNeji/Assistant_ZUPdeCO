# App
NODE_ENV=development
PORT=3000
SERVICE_NAME=ednov-backend
LOG_LEVEL=info

# Database (PostgreSQL) – un seul schéma pour le monolithe
# Supabase / hosted Postgres : utiliser DATABASE_SSL=true et l’URL fournie (Settings → Database)
# Ex. Supabase : postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Autres environnements : DATABASE_URL_<NOM> pour chaque environnement
# Usage: npm run seed:all -- --env=recette (ou npm run migration:run -- --env=recette)
DATABASE_URL_RECETTE=postgresql://user:password@host:5432/dbname_recette
DATABASE_URL_REMOTE=postgresql://user:password@host:5432/dbname
# DATABASE_URL_PROD=postgresql://...
# DATABASE_URL_STAGING=postgresql://...
DATABASE_SCHEMA=public
DATABASE_SCHEMA_REMOTE=remote
# Mettre à true pour Supabase ou toute connexion TLS
DATABASE_SSL=false
DATABASE_LOGGING=false

# Firebase Admin (auth + JWT)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Firebase Web API key — legacy (no longer used for invitation emails; kept for other flows).
FIREBASE_WEB_API_KEY=your-web-api-key
# Base URL used in invitation/activation email links (e.g. https://app.example.com).
FRONTEND_URL=http://localhost:5173

# Account activation (POST /users/invite email path): secret signing the 14-day activation JWT.
# Use a long random string (>= 16 chars). Rotating it invalidates all outstanding activation links.
INVITATION_JWT_SECRET=change-me-to-a-long-random-secret

# Seed (optional – Firebase UID of the test user created by npm run seed)
# If set, the seed script creates a user with this firebase_uid so you can test login.
# SEED_FIREBASE_UID=evwlub60lDVVXClJxAhM2k7QCwj1

# Sync tutor login: if you sign in with tutor.test@ednov.fr but get redirected back to login (backend 401),
# set this to the Firebase UID of that user (Firebase Console → Authentication → Users → User UID), then run:
#   npm run seed:sync-firebase-uid
# SYNC_FIREBASE_UID=

# Optional: test GET /sessions like the mobile app (npm run seed:test-sessions-http).
# FIREBASE_WEB_API_KEY is also listed above for invitation emails (same as EXPO_PUBLIC_FIREBASE_API_KEY on mobile).
# TEST_PASSWORD = password for tutor.test@ednov.fr
# TEST_API_BASE = http://localhost:3000/api/v1

# CORS (include 8081 for React Native / Metro dev server)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8081

# Transactional email (SendGrid Web API)
SENDGRID_API_KEY=
TRANSACTIONAL_MAIL_FROM=coordocollege@zupdeco.org
TRANSACTIONAL_MAIL_FROM_NAME=Équipe Zupdeco
TRANSACTIONAL_MAIL_ENABLED=false

# Groq (STT Whisper + LLM for CR and pedagogical resources generation)
GROQ_API_KEY=your-groq-api-key

# Optional: platform help assistant (POST /api/v1/ai/help-chat) — defaults shown
# GROQ_HELP_MODEL=llama-3.1-8b-instant
# GROQ_HELP_MAX_TOKENS=512
# GROQ_HELP_TEMPERATURE=0.3

# Optional: if set, when the top MiniSearch score is below this number, the model gets a "weak match" hint (tune per deployment).
# HELP_KNOWLEDGE_WEAK_SCORE_MAX=

# Large establishment Excel exports: rows fetched per DB batch (default 2000, clamped 100–10000).
ESTABLISHMENT_EXPORT_BATCH_SIZE=2000

# Students: min. "present" session participations (as student) for accompanied vs registered.
# SessionsService (promotion on attendance), UsersService (réactivation élève, GET /users/:id reactivationTargetStatus).
STUDENT_ACCOMPANIED_MIN_PRESENT_SESSIONS=3
