{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": "swc",
    "typeCheck": false,
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/help-assistant/knowledge/**/*.md",
        "watchAssets": false
      }
    ]
  }
}
